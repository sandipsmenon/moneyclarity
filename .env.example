# ─────────────────────────────────────────────────────────────────────────────
# Money Clarity — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...    # safe for client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # SERVER ONLY — never expose to browser
SUPABASE_JWT_SECRET=your-supabase-jwt-secret   # Settings > API > JWT Secret

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/gmail/callback (dev)
#                          https://api.yourdomain.com/gmail/callback (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
OAUTH_REDIRECT_URL=http://localhost:8000/gmail/callback

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_SECRET=BASE64_ENCODED_32_BYTE_KEY

# Key rotation (optional): comma-separated "kid:b64key" pairs; last entry is active
# ENCRYPTION_KEYS=v1:OLD_KEY_BASE64,v2:NEW_KEY_BASE64

# ── Database (optional direct connection) ────────────────────────────────────
# Only needed if using asyncpg directly instead of Supabase REST
# Found at: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Redis (optional, for Celery workers) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
BACKEND_CORS_ORIGINS=["http://localhost:8501"]

# ── AI (Claude Haiku for statement anonymizer) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
